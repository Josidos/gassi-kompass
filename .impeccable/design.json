    {
      "name": "Register-Reiter",
      "kind": "nav",
      "refersTo": "register-tab",
      "description": "Pfad als Reiter am Einband; der aktuelle Reiter geht in das Papier über.",
      "html": "<nav class=\"ds-top\"><div class=\"ds-crumbs\"><a href=\"#\">Start</a><a href=\"#\">Kanton Zürich</a><span aria-current=\"page\">Stadt Zürich</span></div></nav>",
      "css": ".ds-top{background:var(--binding);padding:16px 16px 0}.ds-crumbs{display:flex;flex-wrap:wrap;gap:4px;align-items:flex-end;font-family:var(--sans);font-size:.88rem;font-weight:650;font-stretch:88%}.ds-crumbs>*{display:inline-flex;align-items:center;min-height:38px;padding:6px 14px;border-radius:4px 4px 0 0}.ds-crumbs a{background:var(--binding-2);color:var(--on-binding);text-decoration:none;transition:background .15s ease}.ds-crumbs a:hover{background:var(--binding-3)}.ds-crumbs a:focus-visible{outline:2px solid var(--on-binding);outline-offset:-4px}.ds-crumbs [aria-current]{background:var(--paper);color:var(--ink);font-weight:750}"
    },
    {
      "name": "Marken",
      "kind": "chip",
      "refersTo": "chip-must",
      "description": "Kleine Stempel: Pflicht, frei, Hinweis, keine Pflicht.",
      "html": "<span class=\"ds-chip ds-must\">Pflicht</span> <span class=\"ds-chip ds-free\">Frei</span> <span class=\"ds-chip ds-note\">Hinweis</span> <span class=\"ds-chip ds-none\">Keine Pflicht</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;padding:2px 8px;border-radius:2px;font-family:var(--sans);font-size:.74rem;font-weight:700;letter-spacing:.02em;line-height:1.5;white-space:nowrap;font-variant-numeric:tabular-nums}.ds-must{background:var(--must-bg);color:var(--must)}.ds-free{background:var(--free-bg);color:var(--free)}.ds-note{background:var(--note-bg);color:var(--note)}.ds-none{background:var(--none-bg);color:var(--none)}"
    },
    {
      "name": "Merkmal",
      "kind": "card",
      "refersTo": "chip-must",
      "description": "Eintrag ohne Kasten: Linie oben, Führungslinie zur Marke, Wert, Text, Quelle.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-top\"><span class=\"ds-k\">Haftpflicht</span><span class=\"ds-chip\">Pflicht</span></div><p class=\"ds-v\">Versicherung nötig</p><p class=\"ds-t\">Wer einen Hund hält, braucht eine Haftpflichtversicherung.</p><div class=\"ds-src\">Quelle: <a href=\"#\">Hundegesetz ZH</a></div></article>",
      "css": ".ds-card{padding:14px 0 20px;border-top:1px solid var(--rule);display:grid;gap:6px;max-width:420px;font-family:var(--serif);color:var(--ink)}.ds-card-top{display:flex;align-items:baseline;gap:8px}.ds-card-top::after{content:\"\";order:1;flex:1;min-width:16px;border-bottom:2px dotted var(--rule);transform:translateY(-4px)}.ds-card-top .ds-chip{order:2;padding:2px 8px;border-radius:2px;background:var(--must-bg);color:var(--must);font-family:var(--sans);font-size:.74rem;font-weight:700}.ds-k{font-family:var(--sans);font-size:.98rem;font-weight:700;font-stretch:90%;color:var(--ink-2)}.ds-v{margin:0;font-family:var(--sans);font-size:1.3rem;line-height:1.15;font-weight:780;font-stretch:82%}.ds-t{margin:0;font-size:.98rem}.ds-src{font-family:var(--sans);font-size:.78rem;color:var(--ink-2)}.ds-src a{color:inherit;text-underline-offset:3px}.ds-src a:hover{color:var(--ink)}.ds-src a:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Tafel «Leine im Wald»",
      "kind": "custom",
      "refersTo": "forest-panel",
      "description": "Signatur: Status gross, Monatsleiste wie die Blühzeit im Pflanzenbuch.",
      "html": "<section class=\"ds-today\"><div class=\"ds-head\"><b>Leine im Wald · Kanton Zürich</b><span>23. November 2026</span></div><p class=\"ds-big\">Heute keine Leinenpflicht im Wald</p><div class=\"ds-track\"><i style=\"left:25%;width:33.3%\">LEINE</i><s style=\"left:88%\"></s></div><div class=\"ds-months\"><span>Jan</span><span>Feb</span><span>Mär</span><span>Apr</span><span>Mai</span><span>Jun</span><span>Jul</span><span>Aug</span><span>Sep</span><span>Okt</span><span>Nov</span><span>Dez</span></div></section>",
      "css": ".ds-today{display:grid;gap:14px;padding:20px 22px 22px;border-radius:3px;background:var(--sheet);border:1px solid var(--rule);box-shadow:0 1px 0 var(--rule-soft),0 10px 24px -18px rgb(22 32 26 / .35);max-width:520px;font-family:var(--sans);color:var(--ink)}.ds-head{display:flex;align-items:baseline;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--rule-soft);font-size:.98rem;font-stretch:90%}.ds-head::after{content:\"\";order:1;flex:1;border-bottom:2px dotted var(--rule);transform:translateY(-4px)}.ds-head span{order:2;font-size:.8rem;color:var(--ink-2)}.ds-big{margin:0;font-size:2.2rem;line-height:1.02;font-weight:800;font-stretch:76%;color:var(--free)}.ds-track{position:relative;height:30px;background:var(--paper);border:1px solid var(--rule);border-radius:2px;margin-top:20px}.ds-track i{position:absolute;top:-1px;bottom:-1px;background:var(--must);color:var(--sheet);font-style:normal;font-size:.7rem;font-weight:800;letter-spacing:.08em;display:flex;align-items:center;justify-content:center}.ds-track s{position:absolute;top:-20px;bottom:-6px;border-left:2px solid var(--ink)}.ds-months{display:grid;grid-template-columns:repeat(12,1fr);font-size:.68rem;font-weight:600;color:var(--ink-2)}"
    },
    {
      "name": "Kantonsregister",
      "kind": "custom",
      "refersTo": "code-square",
      "description": "Kennung im Rost-Quadrat, Name, Zahl der Gemeinden; Linien statt Rahmen.",
      "html": "<div class=\"ds-raster\"><a class=\"ds-dest\" href=\"#\"><span class=\"ds-code\">AG</span><span class=\"ds-name\">Aargau</span><span class=\"ds-sub\">2 Gemeinden</span></a><a class=\"ds-dest\" href=\"#\"><span class=\"ds-code\">ZH</span><span class=\"ds-name\">Zürich</span><span class=\"ds-sub\">14 Gemeinden</span></a></div>",
      "css": ".ds-raster{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:0 28px;border-top:2px solid var(--ink);font-family:var(--sans);}.ds-dest{display:grid;grid-template-columns:auto 1fr;column-gap:12px;align-items:center;min-height:56px;padding:9px 0;border-bottom:1px solid var(--rule-soft);color:var(--ink);text-decoration:none}.ds-code{grid-row:1/3;display:grid;place-items:center;width:40px;height:34px;border-radius:2px;background:var(--code);color:var(--on-code);font-weight:800;font-stretch:80%;font-size:.95rem;letter-spacing:.02em}.ds-name{font-weight:720;font-stretch:88%;font-size:1.02rem}.ds-sub{font-size:.76rem;color:var(--free);font-variant-numeric:tabular-nums}.ds-dest:hover .ds-name{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px}.ds-dest:focus-visible{outline:3px solid var(--focus);outline-offset:2px}"
